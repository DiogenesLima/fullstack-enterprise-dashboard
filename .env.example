# ==============================================================================
# ENTERPRISE DASHBOARD - ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file serves as a template. Please copy to .env and customise as needed.
# Note: Ensure sensitive credentials are never committed to version control.
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
DB_USER=admin
DB_PASSWORD=admin123
DB_NAME=enterprise_dashboard
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public
# Cache Configuration (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# API Application Settings (NestJS)
# ------------------------------------------------------------------------------
API_PORT=3001
NODE_ENV=development
# Secret key for JWT signing - must be a robust string in production
JWT_SECRET=change_this_to_a_secure_random_string_for_production
# Frontend Application Settings (Nuxt 4)
# ------------------------------------------------------------------------------
# Point the frontend to the backend API endpoint
NUXT_PUBLIC_API_BASE=http://localhost:3001/api/v1
